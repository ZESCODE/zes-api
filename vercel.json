{
  "framework": null,
  "installCommand": "bun install --cwd web --frozen-lockfile",
  "buildCommand": "bun run --cwd web build",
  "outputDirectory": "web/dist",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://zes-api.bonto.run/api/:path*"
    },
    {
      "source": "/pg/:path*",
      "destination": "https://zes-api.bonto.run/pg/:path*"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "https://zes-api.bonto.run/dashboard/:path*"
    },
    {
      "source": "/v1/:path*",
      "destination": "https://zes-api.bonto.run/v1/:path*"
    },
    {
      "source": "/v1beta/:path*",
      "destination": "https://zes-api.bonto.run/v1beta/:path*"
    },
    {
      "source": "/mj/:path*",
      "destination": "https://zes-api.bonto.run/mj/:path*"
    },
    {
      "source": "/:mode/mj/:path*",
      "destination": "https://zes-api.bonto.run/:mode/mj/:path*"
    },
    {
      "source": "/((?!static/|favicon\\.ico$|index\\.html$).*)",
      "destination": "/index.html"
    }
  ]
}
