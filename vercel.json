{
  "framework": null,
  "installCommand": "bun install --cwd web --frozen-lockfile",
  "buildCommand": "bun run --cwd web build",
  "outputDirectory": "web/dist",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://newapi.zes.codes/api/:path*"
    },
    {
      "source": "/((?!static/|favicon\\.ico$|index\\.html$).*)",
      "destination": "/index.html"
    }
  ]
}
